# XMPP WebSocket connection URL injected into index.html at build time.
# Override this env var in CI or with a local .env.local to point at a different server.
#
# Docker test server (local):
VITE_CONNECTION_URL=ws://127.0.0.1:5280/ws
#
# Production server:
# VITE_CONNECTION_URL=wss://xmpp.redsolution.com/wsserver
